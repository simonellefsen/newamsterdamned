# Copy to .env.local (gitignored) for live voice pack generation.
# `npm run voice:generate:live` loads this file; no need to export by hand.
# Confirm OpenAI ToS allows redistributing TTS audio on a public CDN before shipping packs.

OPENAI_API_KEY=

# Optional. Where the game loads Act I pack audio from (must end with / or we add it).
# Default: /voice/v1/ (same origin — local static/ or prebuilt deploy with lines/ present).
# Production CDN example: https://cdn.example.com/voice/v1/
# PUBLIC_VOICE_BASE_URL=
